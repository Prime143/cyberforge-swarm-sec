FROM python:3.11-slim AS builder
WORKDIR /app
# Implement dependency caching and compilation here

# ------------------------------------------
# FINAL RUNTIME STAGE
# ------------------------------------------
FROM gcr.io/distroless/python3
WORKDIR /app

# Copy artifacts from builder
# COPY --from=builder /app /app

# Set non-root user execution
# USER nonroot

ENTRYPOINT ["python", "-m", "services.ingress_gateway.crypto.verifier"]
